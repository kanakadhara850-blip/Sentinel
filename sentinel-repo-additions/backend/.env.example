# Copy to .env and export before running. Never commit real secrets.
BUS_BACKEND=memory            # memory | kafka
KAFKA_BOOTSTRAP=localhost:9092
REDIS_URL=                    # e.g. redis://localhost:6379/0 ; empty = in-memory feature store
DB_PATH=data/risk.db
PSEUDONYM_KEY=change-me-pseudonym-key
AUDIT_SIGNING_KEY=change-me-audit-key
TCP_TOKEN=                    # optional shared token required in every socket message
API_KEY=                      # optional; if set, REST needs X-API-Key and WS needs ?key=
WORKERS=2
